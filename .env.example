# Copy to `.env` and adjust for your machine. Never commit your real `.env`.

# Postgres connection (async driver). Matches the docker-compose defaults.
DATABASE_URL=postgresql+asyncpg://ripcord:ripcord@localhost:5432/ripcord

# Redis connection (cache + pub/sub).
REDIS_URL=redis://localhost:6379/0

# API-key auth on the management + SDK endpoints. Defaults to true; set to
# false only for local experiments (the app logs a warning when it is off).
AUTH_ENABLED=true

# Bootstrap admin key — solves the "you need a key to make a key" problem.
# Generate one with:  python -m ripcord.cli mint-bootstrap
# Unset this once you have created a real admin key via POST /keys.
# BOOTSTRAP_ADMIN_KEY=rpc_xxxxxxxxxxxx_yyyyyyyy...
